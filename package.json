    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "fflate": "0.8.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "rollup": "4.63.6"
  }
}
